---
import gasistas from '../data/gasistas.json';

const ZONES: Record<string, string[]> = {
  "Centro":      ["Centro", "Pichincha", "Abasto", "Echesortu", "Barrio Martín", "República de la Sexta", "Lourdes", "Terminal / Agote"],
  "Norte":       ["Alberdi", "Arroyito", "Refinería", "Sarmiento", "La Florida", "Parque Field", "Rucci", "Lomas de Alberdi"],
  "Noroeste":    ["Fisherton", "Belgrano", "Azcuénaga", "Empalme Granero", "Ludueña", "Hostal del Sol", "Aldea", "San Eduardo"],
  "Sur":         ["Saladillo", "Tiro Suizo", "Tablada", "España y Hospitales", "Las Heras", "Acindar"],
  "Oeste":       ["Bella Vista", "Cinco Esquinas", "Barrio Godoy", "Barrio Alvear", "Vía Honda"],
  "Alrededores": ["Funes", "Roldán", "Granadero Baigorria", "San Lorenzo", "Capitán Bermúdez", "Fray Luis Beltrán", "Puerto Gral. San Martín", "Villa Gobernador Gálvez", "Pueblo Esther", "Arroyo Seco", "Alvear", "General Lagos", "Luis Palacio", "Ybarlucea"],
};

const allServices = [...new Set(gasistas.flatMap((g: any) => g.services))].sort((a: any, b: any) => a.localeCompare(b, 'es'));
const total = gasistas.length;
const zoneChips = ['Todo Rosario', ...Object.keys(ZONES)];
---

<div class="sticky top-[68px] z-40 pointer-events-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-3 pointer-events-auto">
    <div id="filter-bar" class="bg-white/96 backdrop-blur-md border border-warm-200/60 rounded-2xl shadow-[0_4px_24px_-8px_rgba(0,0,0,0.08),0_1px_2px_rgba(0,0,0,0.04)] px-3 sm:px-4">

      <!-- Fila 1: búsqueda + servicio + contador + limpiar -->
      <div class="flex items-center gap-1.5 sm:gap-2 py-2.5">

        <!-- Búsqueda por nombre -->
        <div class="relative flex-1 min-w-0 max-w-[180px] sm:max-w-xs">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="absolute left-2.5 top-1/2 -translate-y-1/2 text-warm-400 pointer-events-none flex-shrink-0" aria-hidden="true">
            <circle cx="5" cy="5" r="3.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M8 8L10.5 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          <input
            type="search"
            id="gasista-search"
            placeholder="Buscar gasista..."
            autocomplete="off"
            class="w-full pl-7 pr-2 py-1.5 rounded-xl border border-warm-200/80 bg-warm-50/70 text-[12px] font-medium text-warm-700 placeholder:text-warm-400/70 focus:outline-none focus:border-flame/30 focus:bg-white transition-all duration-200"
          />
        </div>

        <div class="hidden sm:block w-px h-3.5 bg-warm-200/80 flex-shrink-0" aria-hidden="true"></div>

        <!-- Servicio dropdown -->
        <div class="relative flex-shrink-0" id="service-wrapper">
          <button
            type="button"
            id="service-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            class="filter-trigger flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-warm-200/80 bg-warm-50/70 text-[12px] font-medium text-warm-700 hover:bg-warm-100 hover:border-warm-300/60 transition-all duration-200"
          >
            <svg width="12" height="12" viewBox="0 0 13 13" fill="none" class="text-warm-500 flex-shrink-0" aria-hidden="true">
              <path d="M2 10L4.5 7.5L2 5L4.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 2.5H11M7 6.5H11M7 10.5H9.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <span id="service-label">Servicio</span>
            <svg width="8" height="5" viewBox="0 0 9 5" fill="none" class="trigger-chevron text-warm-400 transition-transform duration-200 flex-shrink-0" aria-hidden="true">
              <path d="M1 1L4.5 4L8 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div
            id="service-panel"
            class="filter-panel hidden absolute top-[calc(100%+8px)] left-0 z-50 w-72 max-w-[calc(100vw-32px)] bg-white border border-warm-200/80 rounded-2xl shadow-[0_8px_32px_-4px_rgba(0,0,0,0.12),0_2px_8px_-2px_rgba(0,0,0,0.06)] py-2 overflow-hidden"
          >
            {allServices.map((s: any) => (
              <button
                type="button"
                class="service-option w-full flex items-center justify-between px-4 py-1.5 text-xs font-medium text-warm-600 hover:bg-warm-50 hover:text-warm-900 transition-all duration-150 text-left"
                data-value={s}
              >
                {s}
                <svg class="service-check hidden w-3 h-3 text-flame flex-shrink-0" viewBox="0 0 12 12" fill="none">
                  <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            ))}
            <div class="border-t border-warm-100 mt-1 pt-1 px-2">
              <button type="button" id="service-clear" class="w-full text-left text-[10px] text-warm-400 hover:text-flame transition-colors duration-150 font-medium px-2 py-1">
                Ver todos los servicios
              </button>
            </div>
          </div>
        </div>

        <!-- Contador + Limpiar -->
        <div class="ml-auto flex items-center gap-2.5 flex-shrink-0">
          <p id="result-count" class="text-[12px] text-warm-700/70">
            <span id="count-number" class="font-semibold text-warm-900/80">{total}</span>
            <span id="count-label" class="hidden sm:inline"> profesionales</span>
          </p>
          <button
            id="reset-filters"
            class="hidden items-center gap-1 text-[11px] text-flame hover:text-flame-dark font-semibold transition-colors duration-200"
            aria-label="Limpiar filtros"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M1 1L9 9M9 1L1 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            Limpiar
          </button>
        </div>

      </div>

      <!-- Fila 2: chips de zona -->
      <div class="relative">
        <div class="flex items-center gap-1.5 pb-2.5 overflow-x-auto scrollbar-none">
          {zoneChips.map((zone) => (
            <button
              type="button"
              class="zone-chip flex-shrink-0 px-3 py-1 rounded-full border border-warm-200/80 bg-warm-50/70 text-[11px] font-semibold text-warm-600 hover:border-warm-300 hover:text-warm-900 transition-all duration-200 whitespace-nowrap"
              data-zona-chip={zone === 'Todo Rosario' ? '__todo_rosario__' : zone}
            >
              {zone}
            </button>
          ))}
        </div>
        <!-- Fade derecho: indica que hay más chips para deslizar, solo en mobile -->
        <div
          class="pointer-events-none absolute right-0 top-0 bottom-2.5 w-10 sm:hidden"
          style="background: linear-gradient(to left, rgba(255,255,255,0.96) 30%, transparent);"
          aria-hidden="true"
        ></div>
      </div>

    </div>
  </div>
</div>

<style>
  .filter-trigger.is-active {
    background: rgba(224, 116, 24, 0.08);
    border-color: rgba(224, 116, 24, 0.25);
    color: #b85c12;
  }
  .filter-trigger.is-active svg { color: #e07418; }
  .filter-trigger[aria-expanded="true"] .trigger-chevron { transform: rotate(180deg); }

  .zone-chip-active {
    background: rgba(224, 116, 24, 0.10);
    border-color: rgba(224, 116, 24, 0.35);
    color: #b85c12;
  }

  .service-option.selected { color: #3d322b; background: #f8f5f1; }
  .service-option.selected .service-check { display: block; }

  .scrollbar-none { scrollbar-width: none; }
  .scrollbar-none::-webkit-scrollbar { display: none; }

  #gasista-search::-webkit-search-cancel-button { display: none; }
</style>

<script>
  const ZONES_DATA: Record<string, string[]> = {
    "Centro":      ["Centro","Pichincha","Abasto","Echesortu","Barrio Martín","República de la Sexta","Lourdes","Terminal / Agote"],
    "Norte":       ["Alberdi","Arroyito","Refinería","Sarmiento","La Florida","Parque Field","Rucci","Lomas de Alberdi"],
    "Noroeste":    ["Fisherton","Belgrano","Azcuénaga","Empalme Granero","Ludueña","Hostal del Sol","Aldea","San Eduardo"],
    "Sur":         ["Saladillo","Tiro Suizo","Tablada","España y Hospitales","Las Heras","Acindar"],
    "Oeste":       ["Bella Vista","Cinco Esquinas","Barrio Godoy","Barrio Alvear","Vía Honda"],
    "Alrededores": ["Funes","Roldán","Granadero Baigorria","San Lorenzo","Capitán Bermúdez","Fray Luis Beltrán","Puerto Gral. San Martín","Villa Gobernador Gálvez","Pueblo Esther","Arroyo Seco","Alvear","General Lagos","Luis Palacio","Ybarlucea"],
  };

  const ALREDEDORES = new Set(ZONES_DATA["Alrededores"]);
  const GROUP_BARRIOS: Record<string, Set<string>> = {};
  Object.entries(ZONES_DATA).forEach(([g, bs]) => { GROUP_BARRIOS[g] = new Set(bs); });

  const servicePanel   = document.getElementById('service-panel')!;
  const serviceTrigger = document.getElementById('service-trigger') as HTMLButtonElement;
  const serviceLabel   = document.getElementById('service-label')!;
  const serviceOpts    = document.querySelectorAll<HTMLButtonElement>('.service-option');
  const serviceClear   = document.getElementById('service-clear') as HTMLButtonElement;
  const zoneChips      = document.querySelectorAll<HTMLButtonElement>('.zone-chip');
  const searchInput    = document.getElementById('gasista-search') as HTMLInputElement;
  const resetBtn       = document.getElementById('reset-filters') as HTMLButtonElement;
  const countNumber    = document.getElementById('count-number')!;
  const countLabel     = document.getElementById('count-label')!;
  const noResults      = document.getElementById('no-results');

  let activeZone    = '';
  let activeService = '';
  let activeSearch  = '';
  let searchTimer: ReturnType<typeof setTimeout>;

  // ── Servicio dropdown ────────────────────────────────────────────────────────
  const closeService = () => {
    servicePanel.classList.add('hidden');
    serviceTrigger.setAttribute('aria-expanded', 'false');
  };
  serviceTrigger.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = serviceTrigger.getAttribute('aria-expanded') === 'true';
    closeService();
    if (!isOpen) {
      servicePanel.classList.remove('hidden');
      serviceTrigger.setAttribute('aria-expanded', 'true');
    }
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#service-wrapper')) closeService();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeService(); });

  // ── Helpers ──────────────────────────────────────────────────────────────────
  const updateCount = (n: number) => {
    countNumber.textContent = String(n);
    countLabel.textContent  = n === 1 ? ' profesional' : ' profesionales';
  };

  const scrollToGrid = () => {
    const filterEl = document.getElementById('filter-bar')?.closest('.sticky') as HTMLElement | null;
    const filterBottom = filterEl ? filterEl.getBoundingClientRect().bottom : 120;
    if (window.scrollY > filterBottom + 100) {
      const grid = document.querySelector('[data-card]')?.closest('section') as HTMLElement ?? document.body;
      const offset = (filterEl?.getBoundingClientRect().height ?? 60) + 12;
      const top = grid.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
    }
  };

  // ── Filtrado principal ───────────────────────────────────────────────────────
  const filterCards = () => {
    const cards = document.querySelectorAll<HTMLElement>('[data-card]');
    let visible = 0;

    cards.forEach(card => {
      const zones    = card.dataset.zones?.split(',').map(z => z.trim()) ?? [];
      const services = card.dataset.services?.split(',').map(s => s.trim()) ?? [];
      const name     = card.dataset.name ?? '';

      let matchesZone = false;
      if (activeZone === '') {
        matchesZone = true;
      } else if (activeZone === '__todo_rosario__') {
        matchesZone = zones.some(z => z === 'Rosario' || z === 'Todo Rosario');
      } else if (activeZone === 'Alrededores') {
        matchesZone = zones.some(z => ALREDEDORES.has(z));
      } else {
        // Zona de la ciudad: cubre 'Rosario' (todo), el nombre de zona directo, o barrios del grupo
        const groupSet = GROUP_BARRIOS[activeZone];
        matchesZone = zones.includes('Rosario') || zones.includes('Todo Rosario')
          || zones.includes(activeZone)
          || zones.some(z => groupSet?.has(z));
      }

      const matchesService = activeService === '' || services.includes(activeService);
      const matchesSearch  = activeSearch === '' || name.includes(activeSearch);

      const show = matchesZone && matchesService && matchesSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    updateCount(visible);
    scrollToGrid();
    const hasFilter = activeZone !== '' || activeService !== '' || activeSearch !== '';
    resetBtn.classList.toggle('hidden', !hasFilter);
    resetBtn.style.display = hasFilter ? 'inline-flex' : '';
    if (noResults) noResults.classList.toggle('hidden', visible > 0);
    document.dispatchEvent(new CustomEvent('filter-change', { detail: { hasFilter } }));
  };

  // ── Chips de zona ────────────────────────────────────────────────────────────
  const setZone = (value: string) => {
    activeZone = value;
    zoneChips.forEach(chip => chip.classList.toggle('zone-chip-active', chip.dataset.zonaChip === value));
    filterCards();
  };

  zoneChips.forEach(chip => {
    chip.addEventListener('click', () => {
      // Toggle: clic en el activo lo deselecciona
      setZone(activeZone === chip.dataset.zonaChip! ? '' : chip.dataset.zonaChip!);
    });
  });

  // ── Servicio ─────────────────────────────────────────────────────────────────
  const setService = (value: string) => {
    activeService = value;
    serviceLabel.textContent = value === '' ? 'Servicio' : value;
    serviceTrigger.classList.toggle('is-active', value !== '');
    serviceOpts.forEach(o => o.classList.toggle('selected', o.dataset.value === value));
    filterCards();
    closeService();
  };

  serviceOpts.forEach(o => o.addEventListener('click', () => {
    setService(activeService === o.dataset.value ? '' : o.dataset.value!);
  }));
  serviceClear.addEventListener('click', () => setService(''));

  // ── Búsqueda por nombre ──────────────────────────────────────────────────────
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      activeSearch = searchInput.value.toLowerCase().trim();
      filterCards();
    }, 300);
  });

  // ── Limpiar todo ─────────────────────────────────────────────────────────────
  resetBtn.addEventListener('click', () => {
    activeSearch = '';
    searchInput.value = '';
    setZone('');
    setService('');
  });
</script>
